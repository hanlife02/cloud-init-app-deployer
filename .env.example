#
# Cloud-Init App Deployer environment variables
# Copy this file to `.env` and update the values as needed.
#

# Required: used to authenticate API requests
API_TOKEN=clabv2

# Optional: Flask runtime configuration
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
PORT=5000

# Optional: service credentials (never commit real secrets)
OPENAI_API_KEY=
OPENAI_PROXY_URL=
ACCESS_CODE=
